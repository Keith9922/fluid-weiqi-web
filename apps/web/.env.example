# Copy to `.env.local` for local dev, or set in your hosting provider's env (Vercel) for prod.

# Public WebSocket URL of the backend, including /ws path.
# Examples:
#   VITE_WS_URL=wss://fluid-api.your-domain.com/ws
#   VITE_WS_URL=wss://successful-cradle-safe-guide.trycloudflare.com/ws  (quick tunnel — will change on restart)
#
# Leave unset for local dev: the Vite dev server proxies /ws to localhost:8787.
VITE_WS_URL=
